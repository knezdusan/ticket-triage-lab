# Which LLM backend to use: "azure" or "openai_compatible".
LLM_PROVIDER=

# Azure OpenAI resource endpoint: https://<resource>.openai.azure.com/
# An Azure AI Foundry project endpoint also works:
# https://<resource>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key. Leave empty to authenticate via Entra ID (azure-identity).
AZURE_OPENAI_API_KEY=

# Azure OpenAI REST API version. Defaults to 2024-10-21; set only to override.
AZURE_OPENAI_API_VERSION=

# The deployment name YOU chose when deploying your chat model in Azure AI
# Foundry — NOT the model name (e.g. you might deploy gpt-4o as "support-chat").
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Same idea: your user-chosen deployment name for the embedding model.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Base URL for an OpenAI-compatible API, e.g. http://localhost:11434/v1.
OPENAI_BASE_URL=

# API key for the OpenAI-compatible API.
OPENAI_API_KEY=

# Chat model name on the OpenAI-compatible API.
OPENAI_CHAT_MODEL=

# Embedding model name on the OpenAI-compatible API.
OPENAI_EMBEDDING_MODEL=
